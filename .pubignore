# A .pubignore replaces .gitignore for `dart pub publish`, so everything the
# .gitignore keeps out is repeated here — **with its anchors**. Unanchored,
# `build/` also matched `lib/src/build/`, and 1.0.0 shipped without the file
# the build hook imports. `test/pubignore_test.dart` keeps every tracked file
# under lib/, hook/ and bin/ in the archive.
.dart_tool/
.fvm/
/build/
/coverage/
/pubspec.lock
*.iml
.idea/

# Internal notes, CI, the README's screenshots (served from GitHub), and the
# example's build output.
CLAUDE.md
doc/
.github/
.pre-commit-config.yaml
example/build/
example/.dart_tool/
test/crasher/.dart_tool/
test/crasher/pubspec.lock
